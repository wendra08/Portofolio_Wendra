---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import '@fontsource-variable/manrope';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import TechIcon from '../components/TechIcon.astro';
import HeroPortrait from '../components/HeroPortrait.astro';
import ProjectCard from '../components/ProjectCard.astro';
import AchievementCard from '../components/AchievementCard.astro';
import {
  profile,
  experiences,
  education,
  skills,
  projects,
  achievements,
} from '../data/portfolio';

const hasCV = existsSync(resolve('public', profile.cvFile));
const baseUrl = import.meta.env.BASE_URL;
const groups = [...new Set(skills.map((skill) => skill.group))];
const navigation = [
  { label: 'About', id: 'about' },
  { label: 'Experience', id: 'experience' },
  { label: 'Education', id: 'education' },
  { label: 'Work', id: 'work' },
  { label: 'Achievements', id: 'achievements' },
];
const socials = [
  { label: 'GitHub', url: profile.github },
  { label: 'LinkedIn', url: profile.linkedin },
].filter((social) => social.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101312" />
    <meta name="description" content={profile.description} />
    <meta property="og:title" content={`${profile.name} — ${profile.title}`} />
    <meta property="og:description" content={profile.description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <title>{profile.name} — {profile.title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container nav-wrap">
        <a href="#home" class="brand" aria-label="Wendra — home"
          >w<span>.</span><span class="brand-label">WENDRA</span></a
        >
        <nav class="desktop-nav" aria-label="Main navigation">
          {navigation.map((item) => <a href={`#${item.id}`}>{item.label}</a>)}
        </nav>
        <a href="#contact" class="nav-contact"
          >Let's connect <Icon name="arrow" size={16} /></a
        >
        <button
          class="menu-toggle"
          aria-label="Open navigation"
          aria-expanded="false"
          aria-controls="mobile-navigation"><span></span><span></span></button
        >
      </div>
      <nav
        id="mobile-navigation"
        class="mobile-nav"
        aria-label="Mobile navigation"
        hidden
      >
        {navigation.map((item) => <a href={`#${item.id}`}>{item.label}</a>)}
        <a href="#skills">Skills</a><a href="#contact">Let's connect</a>
      </nav>
    </header>

    <main id="main">
      <section id="home" class="hero container">
        <div class="hero-main">
          <div class="hero-copy">
            <p class="eyebrow hero-eyebrow">
              <span class="status-dot"></span> IT DEVELOPER & IT SPECIALIST
            </p>
            <h1>
              <span class="name-first">Muhammad</span><span
                class="name-highlight"
                >Wendra<span class="name-dot">.</span></span
              ><span class="name-last">Suryananda</span>
            </h1>
            <p class="hero-description">
              Connecting the dots between <strong
                >people,<br class="desktop-break" /> infrastructure, and code.</strong
              >
            </p>
            <p class="hero-context">
              From teaching technology to supporting IT systems<br
                class="desktop-break"
              /> and developing software. This is my journey.
            </p>
            <div class="hero-actions">
              <a href="#work" class="button button-primary"
                >Explore my work <Icon name="arrow" size={18} /></a
              >
              {
                hasCV ? (
                  <a
                    class="button button-text"
                    href={`${baseUrl}${profile.cvFile}`}
                    download
                  >
                    Download CV <Icon name="download" size={18} />
                  </a>
                ) : (
                  <span class="cv-pending">
                    <>
                      <button
                        class="button button-text"
                        disabled
                        aria-describedby="cv-note"
                      >
                        Download CV <Icon name="download" size={18} />
                      </button>
                      <span id="cv-note">PDF coming soon</span>
                    </>
                  </span>
                )
              }
            </div>
          </div>
          <HeroPortrait />
        </div>
        <div class="hero-bottom">
          <p>
            <span class="status-dot"></span> Currently at <strong
              >PT Graha Prima Energy</strong
            >
          </p><a href="#about" class="scroll-cue"
            >SCROLL TO DISCOVER <Icon name="down" size={16} /></a
          >
        </div>
      </section>

      <section class="toolbelt" aria-label="Technology highlights">
        <div class="container toolbelt-top">
          <p class="eyebrow">THE TOOLS BEHIND THE WORK</p><button
            class="motion-toggle"
            aria-pressed="false"
            aria-label="Pause animations"
            ><Icon name="pause" size={14} /><span>Pause motion</span></button
          >
        </div>
        <div
          class="marquee"
          tabindex="0"
          role="group"
          aria-label="Technology logos. Animation pauses while focused."
        >
          <div class="marquee-track">
            {
              [0, 1].map((copy) => (
                <div
                  class="marquee-group"
                  aria-hidden={copy === 1 ? 'true' : undefined}
                >
                  {skills.map((skill) => (
                    <div class="marquee-item">
                      <TechIcon name={skill.icon} />
                      <span>{skill.name}</span>
                    </div>
                  ))}
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section id="about" class="section container">
        <div class="section-kicker">
          <span>01 / ABOUT</span><span>A LITTLE CONTEXT</span>
        </div>
        <div class="about-grid">
          <h2>A technical mind.<br />A <em>human perspective.</em></h2>
          <div class="about-copy" data-reveal>
            <p>
              Hi, I'm Wendra. My career in IT has taken me from the classroom to
              company infrastructure, and into software development.
            </p><p>
              I've worked as an IT Advanced Teacher at Koding Next, an IT
              Specialist at PT ITCI Kartika Utama, and now an IT Developer at PT
              Graha Prima Energy. Each chapter brings a different perspective to
              how I approach technology.
            </p><a class="text-link" href="#experience"
              >Get to know my journey <Icon name="right" size={18} /></a
            >
          </div>
        </div>
        <div class="disciplines">
          <article data-reveal>
            <span class="discipline-icon"><Icon name="teach" size={25} /></span
            ><span class="mini-number">01</span><h3>Share knowledge.</h3><p>
              A background in teaching technology and helping others learn.
            </p>
          </article>
          <article data-reveal>
            <span class="discipline-icon"
              ><Icon name="network" size={25} /></span
            ><span class="mini-number">02</span><h3>Connect systems.</h3><p>
              Experience across IT infrastructure, networking, and storage.
            </p>
          </article>
          <article data-reveal>
            <span class="discipline-icon"><Icon name="code" size={25} /></span
            ><span class="mini-number">03</span><h3>Build with purpose.</h3><p>
              A focus on web development, software, and business applications.
            </p>
          </article>
        </div>
      </section>

      <section id="experience" class="section container">
        <div class="section-kicker">
          <span>02 / EXPERIENCE</span><span>THE JOURNEY SO FAR</span>
        </div>
        <div class="section-heading">
          <h2>Different roles.<br /><em>One evolving journey.</em></h2><p>
            Three chapters in IT.<br />A perspective shaped by each one.
          </p>
        </div>
        <div class="timeline">
          {
            experiences.map((experience, i) => (
              <article
                class:list={[
                  'experience-row',
                  { 'is-current': experience.current },
                ]}
                data-reveal
              >
                <>
                  <div class="experience-marker">
                    <>
                      <span>
                        {String(experiences.length - i).padStart(2, '0')}
                      </span>
                      <i />
                    </>
                  </div>
                  <div class="experience-company">
                    <>
                      <div class="experience-meta">
                        {experience.current ? (
                          <span class="current-badge">
                            <span class="status-dot" /> CURRENT ROLE
                          </span>
                        ) : (
                          <span>PREVIOUS CHAPTER</span>
                        )}
                        {experience.period && <span>{experience.period}</span>}
                      </div>
                      <h3>{experience.company}</h3>
                      <p>{experience.role}</p>
                    </>
                  </div>
                  <div class="experience-discipline">
                    <>
                      <Icon
                        name={i === 0 ? 'code' : i === 1 ? 'network' : 'teach'}
                        size={20}
                      />
                      <span>{experience.discipline}</span>
                    </>
                  </div>
                </>
              </article>
            ))
          }
        </div>
      </section>

      <section id="education" class="section container education-section">
        <div class="section-kicker">
          <span>03 / EDUCATION</span><span>ACADEMIC FOUNDATION</span>
        </div>
        <div class="section-heading">
          <h2>Built through study.<br /><em>Proven through achievement.</em></h2>
          <p>
            An Informatics education shaped by<br />curiosity, discipline, and practical work.
          </p>
        </div>
        <article class="education-card" data-reveal>
          <div class="education-mark">
            <img
              src={`${baseUrl}images/education/universitas-mulawarman.svg`}
              alt="Universitas Mulawarman logo"
            />
            <span>UNMUL</span>
          </div>
          <div class="education-main">
            <p class="education-label">UNIVERSITY EDUCATION</p>
            <h3>{education.institution}</h3>
            <p class="education-program">{education.program}</p>
            <p class="education-description">{education.description}</p>
          </div>
          <dl class="education-facts">
            <div>
              <dt>Program</dt>
              <dd>{education.program}</dd>
            </div>
            <div>
              <dt>Period</dt>
              <dd>{education.period}</dd>
            </div>
            <div>
              <dt>GPA</dt>
              <dd>{education.gpa}</dd>
            </div>
            <div>
              <dt>Recognition</dt>
              <dd>{education.recognition}</dd>
            </div>
          </dl>
        </article>
      </section>

      <section id="skills" class="section skills-section">
        <div class="container">
          <div class="section-kicker">
            <span>04 / TOOLKIT</span><span>TECHNOLOGIES I WORK WITH</span>
          </div>
          <div class="section-heading">
            <h2>The right tools.<br /><em>For the real work.</em></h2><p>
              From networks and storage to<br />web development and machine
              learning.
            </p>
          </div>
          <div class="skill-groups">
            {
              groups.map((group, i) => (
                <div class="skill-group" data-reveal>
                  <>
                    <h3>
                      <span>{String(i + 1).padStart(2, '0')}</span>
                      {group}
                    </h3>
                    <ul>
                      {skills
                        .filter((skill) => skill.group === group)
                        .map((skill) => (
                          <li>
                            <TechIcon name={skill.icon} />
                            <span>{skill.name}</span>
                          </li>
                        ))}
                    </ul>
                  </>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section id="work" class="section container">
        <div class="section-kicker">
          <span>05 / SELECTED WORK</span><span>IDEAS INTO PRACTICE</span>
        </div>
        <div class="section-heading">
          <h2>A closer look<br /><em>at the work.</em></h2><p>
            Business applications built around real workflows.<br />More project stories to follow.
          </p>
        </div>
        <div class="project-grid">
          {
            projects.map((project, index) => (
              <ProjectCard project={project} index={index} />
            ))
          }
        </div>
      </section>

      <section id="achievements" class="section container">
        <div class="section-kicker">
          <span>06 / ACHIEVEMENTS</span><span>MILESTONES THAT MATTER</span>
        </div>
        <div class="achievement-showcase">
          <div>
            <h2>Always learning.<br /><em>Always moving forward.</em></h2><p
              class="achievement-intro"
            >
              Milestones from my university years:<br
                class="desktop-break"
              /> academic recognition and AI innovation through teamwork.
            </p>
          </div><div class="achievement-gallery">
            {
              achievements.length ? (
                achievements.map((achievement) => (
                  <AchievementCard achievement={achievement} />
                ))
              ) : (
                <div class="achievement-empty">
                  <>
                    <div class="award-symbol">
                      <Icon name="award" size={38} />
                    </div>
                    <span class="coming-soon">COLLECTION IN PROGRESS</span>
                    <h3>The next chapter belongs here.</h3>
                    <p>Achievements and certifications will be added soon.</p>
                    <div class="empty-line">
                      <>
                        <span />
                        <Icon name="plus" size={16} />
                      </>
                    </div>
                  </>
                </div>
              )
            }
          </div>
        </div>
      </section>

      <section id="contact" class="contact-section">
        <div class="container">
          <div class="section-kicker">
            <span>07 / GET IN TOUCH</span><span
              >GOOD WORK STARTS WITH A CONVERSATION</span
            >
          </div><div class="contact-layout">
            <div>
              <p class="eyebrow">HAVE SOMETHING IN MIND?</p><h2>
                Let's make<br /><em>the connection.</em><span
                  class="contact-period">↗</span
                >
              </h2>
            </div><div class="contact-details">
              <p>
                Whether it's about technology, a project,<br
                  class="desktop-break"
                /> or exchanging ideas — let's connect.
              </p>{
                profile.email ? (
                  <a
                    class="button button-primary"
                    href={`mailto:${profile.email}`}
                  >
                    Say hello <Icon name="arrow" size={18} />
                  </a>
                ) : (
                  <p class="contact-pending">
                    <Icon name="mail" size={18} /> Contact details coming soon
                  </p>
                )
              }{
                socials.length > 0 && (
                  <div class="social-links">
                    {socials.map((social) => (
                      <a
                        href={social.url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {social.label}
                        <Icon name="arrow" size={15} />
                      </a>
                    ))}
                  </div>
                )
              }
            </div>
          </div>
        </div>
      </section>
    </main>
    <footer class="container footer">
      <a href="#home" class="brand" aria-label="Back to home">w<span>.</span></a
      ><p>© {new Date().getFullYear()} Muhammad Wendra Suryananda</p><a
        href="#home"
        class="back-top">BACK TO TOP <Icon name="arrow" size={15} /></a
      >
    </footer>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
