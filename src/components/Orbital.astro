---
import Icon from './Icon.astro';
---

<div class="orbital" aria-hidden="true">
  <div class="orbital-coordinate coord-top">SYSTEM / MWS—01</div>
  <div class="orbital-coordinate coord-side">EDUCATE. CONNECT. BUILD.</div>
  <div class="orbit-field">
    <div class="orbit-ring ring-outer"></div>
    <div class="orbit-ring ring-middle"></div>
    <div class="orbit-ring ring-inner"></div>
    <div class="orbit-traveller"><span></span></div>
    <div class="orb-glow"></div>
    <svg class="globe" viewBox="0 0 400 400" fill="none">
      <defs>
        <radialGradient id="sphere-fill" cx="35%" cy="25%" r="80%"
          ><stop stop-color="#204840"></stop><stop
            offset=".55"
            stop-color="#0d2827"></stop><stop offset="1" stop-color="#091616"
          ></stop></radialGradient
        >
        <linearGradient
          id="sphere-line"
          x1="90"
          y1="60"
          x2="310"
          y2="340"
          gradientUnits="userSpaceOnUse"
          ><stop stop-color="#8bdbc4" stop-opacity=".65"></stop><stop
            offset="1"
            stop-color="#459783"
            stop-opacity=".08"></stop></linearGradient
        >
        <clipPath id="sphere-clip"
          ><circle cx="200" cy="200" r="150"></circle></clipPath
        >
      </defs>
      <circle
        cx="200"
        cy="200"
        r="150"
        fill="url(#sphere-fill)"
        stroke="#75c4b0"
        stroke-opacity=".3"></circle>
      <g
        clip-path="url(#sphere-clip)"
        stroke="url(#sphere-line)"
        transform="rotate(-24 200 200)"
      >
        <ellipse cx="200" cy="200" rx="35" ry="150"></ellipse><ellipse
          cx="200"
          cy="200"
          rx="78"
          ry="150"></ellipse><ellipse cx="200" cy="200" rx="117" ry="150"
        ></ellipse><ellipse cx="200" cy="200" rx="145" ry="150"></ellipse>
        <ellipse cx="200" cy="200" rx="150" ry="32"></ellipse><ellipse
          cx="200"
          cy="200"
          rx="150"
          ry="76"></ellipse><ellipse cx="200" cy="200" rx="150" ry="115"
        ></ellipse><ellipse cx="200" cy="200" rx="150" ry="143"></ellipse>
        <path d="M50 200h300M200 50v300"></path>
      </g>
      <circle cx="119" cy="117" r="4" fill="#a9f4d9"></circle><circle
        cx="281"
        cy="227"
        r="3"
        fill="#a9f4d9"></circle>
    </svg>
    <div class="orbit-node node-code">
      <Icon name="code" size={25} /><span>Development</span>
    </div>
    <div class="orbit-node node-network">
      <Icon name="network" size={23} /><span>Infrastructure</span>
    </div>
    <div class="orbit-node node-teach">
      <Icon name="teach" size={24} /><span>Education</span>
    </div>
    <div class="orbit-cross cross-one">+</div><div
      class="orbit-cross cross-two"
    >
      +
    </div>
  </div>
  <div class="orbital-caption">
    <span class="status-dot"></span> Different disciplines. One connected mindset.
  </div>
</div>
