---
import type { Achievement } from '../data/portfolio';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
interface Props {
  achievement: Achievement;
}
const { achievement } = Astro.props;
---

<article class="milestone-card" data-reveal>
  {
    achievement.image && (
      <div class="milestone-image">
        <Image
          src={achievement.image}
          alt={achievement.imageAlt ?? achievement.title}
          widths={[360, 600, 960]}
          sizes="(max-width: 700px) calc(100vw - 44px), (max-width: 1100px) 44vw, 600px"
          format="webp"
          quality={90}
          loading="lazy"
        />
      </div>
    )
  }
  <div class="milestone-body">
    <div class="milestone-meta">
      <span>{achievement.category ?? 'Achievement'}</span><span
        >{achievement.year}</span>
    </div>
    <h3>{achievement.title}</h3>
    <p class="milestone-issuer">{achievement.issuer}</p>
    {
      achievement.highlight && (
        <p class="milestone-highlight">
          <Icon name="award" size={19} />
          {achievement.highlight}
        </p>
      )
    }
    <p class="milestone-description">{achievement.description}</p>
    {
      achievement.contribution && (
        <div class="milestone-contribution">
          <h4>My contribution</h4>
          <p>{achievement.contribution}</p>
        </div>
      )
    }
    {
      achievement.url && (
        <a
          class="text-link"
          href={achievement.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {achievement.linkLabel ?? 'View credential'}{' '}
          <Icon name="arrow" size={16} />
          <span class="sr-only">(opens in a new tab)</span>
        </a>
      )
    }
  </div>
</article>

<style>
  .milestone-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    background: #141a16;
  }
  .milestone-image {
    height: 330px;
    padding: 18px;
    display: flex;
    justify-content: center;
    background: #1a211b;
    border-bottom: 1px solid var(--line);
  }
  .milestone-image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .milestone-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex: 1;
    padding: 28px;
  }
  .milestone-meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    margin-bottom: 17px;
    font: 9px var(--font-mono);
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #b7cbb7;
  }
  .milestone-meta > span:last-child {
    color: var(--muted);
  }
  h3 {
    font-size: 25px;
    line-height: 1.3;
  }
  .milestone-issuer {
    font-size: 11px;
    line-height: 1.8;
    color: var(--muted);
    margin-top: 10px;
  }
  .milestone-highlight {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--accent);
    font-size: 12px;
    margin-top: 22px;
  }
  .milestone-description,
  .milestone-contribution p {
    font-size: 13px;
    line-height: 1.9;
    color: #b8c1b7;
  }
  .milestone-description {
    margin-top: 18px;
  }
  .milestone-contribution {
    margin-top: 21px;
    border-left: 2px solid #86b69a;
    padding-left: 16px;
  }
  .milestone-contribution h4 {
    font: 9px var(--font-mono);
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 8px;
  }
  .text-link {
    margin-top: auto;
    padding-top: 26px;
    padding-bottom: 0;
  }
  @media (max-width: 1100px) {
    .milestone-image {
      height: 280px;
    }
    .milestone-body {
      padding: 23px;
    }
    h3 {
      font-size: 22px;
    }
  }
  @media (max-width: 700px) {
    .milestone-image {
      height: 290px;
      padding: 14px;
    }
    .milestone-body {
      padding: 22px;
    }
    h3 {
      font-size: 22px;
    }
    .milestone-meta {
      font-size: 8px;
      letter-spacing: 0.5px;
    }
  }
  @media print {
    .milestone-card {
      background: white;
      break-inside: avoid;
    }
    .milestone-image {
      height: 200px;
      background: white;
    }
  }
</style>
