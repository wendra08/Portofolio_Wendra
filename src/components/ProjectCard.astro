---
import type { Project } from '../data/portfolio';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import ProjectArtwork from './ProjectArtwork.astro';
interface Props {
  project: Project;
  index: number;
}
const { project, index } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const assetUrl = (path: string) =>
  `${baseUrl.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
---

<article
  class:list={['project-card', { 'project-featured': !project.placeholder }]}
  data-reveal
>
  <div class:list={['project-art', `project-art-${index}`]}>
    {
      project.image ? (
        typeof project.image === 'string' ? (
          <img
            src={assetUrl(project.image)}
            alt={project.imageAlt ?? project.title}
            loading="lazy"
          />
        ) : (
          <Image
            src={project.image}
            alt={project.imageAlt ?? project.title}
            widths={[400, 700, 1000]}
            sizes="(max-width: 900px) 90vw, 650px"
            format="webp"
            quality={90}
            loading="lazy"
          />
        )
      ) : (
        <ProjectArtwork index={index} />
      )
    }
    <span class="project-category">{project.category}</span>
  </div>
  <div class="project-content">
    <div class="project-status">
      <span class="mini-number"
        >PROJECT / {String(index + 1).padStart(2, '0')}</span
      >
      {project.placeholder && <span class="coming-soon">COMING SOON</span>}
    </div>
    <h3>{project.title}</h3>
    <p>{project.description}</p>
    <div class="project-tags">
      {project.tags.map((tag) => <span>{tag}</span>)}
    </div>
    {
      !project.placeholder && project.url && (
        <a
          class="text-link"
          href={assetUrl(project.url)}
        >
          {project.linkLabel ?? 'View project'} <Icon name="arrow" size={16} />
        </a>
      )
    }
  </div>
</article>

<style>
  .project-featured {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 30px;
    border: 1px solid var(--line);
    background: #141a16;
    padding: 24px;
  }
  .project-featured .project-art {
    height: auto;
    min-height: 270px;
    background: #1b231d;
    border: 0;
  }
  .project-featured .project-art :global(img) {
    object-fit: contain;
    padding-bottom: 34px;
  }
  .project-featured .project-content {
    padding-top: 5px;
  }
  .project-featured h3 {
    font-size: 25px;
    line-height: 1.35;
  }
  .project-featured .project-content > p {
    min-height: 0;
  }
  .project-featured .project-category {
    bottom: 8px;
    left: 0;
    font-size: 9px;
  }
  @media (max-width: 1100px) {
    .project-featured {
      gap: 22px;
    }
    .project-featured h3 {
      font-size: 22px;
    }
  }
  @media (max-width: 900px) {
    .project-featured {
      grid-template-columns: 1fr;
    }
    .project-featured .project-art {
      aspect-ratio: 2;
      min-height: 0;
    }
  }
  @media (max-width: 700px) {
    .project-featured {
      padding: 18px;
      gap: 18px;
    }
    .project-featured h3 {
      font-size: 22px;
    }
    .project-featured .project-art {
      aspect-ratio: 1.7;
    }
    .project-featured .project-category {
      font-size: 8px;
    }
  }
</style>
